# ═══════════════════════════════════════
# triLanguage — Supabase + Vercel config
# Copy to .env.local for development
# ═══════════════════════════════════════

# ── Supabase (required) ────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
# Service Role key has admin privileges — KEEP SECRET. Use in production only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Agnes AI ───────────────────────────
AGNES_API_KEY=sk-your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_FAST=agnes-2.5-flash
AGNES_TIMEOUT_MS=45000
AGNES_MAX_RPM=12

# ── App ────────────────────────────────
SESSION_TTL_SECONDS=86400
SESSION_SECRET=random-secret-at-least-32-chars-long

# ── Frontend (Vite env vars, public) ──
# Only needed if frontend calls Supabase directly (not used here — all via API routes)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
